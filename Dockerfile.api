FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY TransportadoraSystem.sln .
COPY src/TransportadoraSystem.Core/TransportadoraSystem.Core.csproj src/TransportadoraSystem.Core/
COPY src/TransportadoraSystem.Infrastructure/TransportadoraSystem.Infrastructure.csproj src/TransportadoraSystem.Infrastructure/
COPY src/TransportadoraSystem.Application/TransportadoraSystem.Application.csproj src/TransportadoraSystem.Application/
COPY src/TransportadoraSystem.API/TransportadoraSystem.API.csproj src/TransportadoraSystem.API/

RUN dotnet restore

COPY . .
RUN dotnet publish src/TransportadoraSystem.API/TransportadoraSystem.API.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0
# OCR da CNH digital (o PDF só traz a imagem): Tesseract com português
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-por && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 5000
# Hospedagens como Render/Cloud Run mandam a porta na variável PORT.
# Sem PORT (docker compose local), usa 5000.
ENTRYPOINT ["sh", "-c", "ASPNETCORE_URLS=http://+:${PORT:-5000} exec dotnet TransportadoraSystem.API.dll"]
